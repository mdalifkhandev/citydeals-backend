generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ADVERTISER
  USER
}

enum CouponStatus {
  DRAFT
  ACTIVE
  EXPIRED
  SUSPENDED
}

model User {
  id                 String   @id @default(cuid())
  fullName           String?
  email              String   @unique
  phoneNumber        String?
  profilePictureUrl  String?
  dateOfBirth        DateTime?
  notificationsPaused Boolean @default(false)
  passwordHash       String
  role               Role     @default(USER)
  areaId             String?
  preferredLanguage  String   @default("en")
  acceptedTerms      Boolean  @default(false)
  onboardingCompleted Boolean @default(false)
  refreshTokenHash   String?
  latitude           Decimal? @db.Decimal(9, 6)
  longitude          Decimal? @db.Decimal(9, 6)
  fcmToken           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  area                Area?                  @relation(fields: [areaId], references: [id])
  merchants           Merchant[]
  notificationEvents  NotificationCooldown[]
  notifications       Notification[]
  savedCoupons        SavedCoupon[]
  couponRedemptions   CouponRedemption[]
  supportTickets      SupportTicket[]
}

model Area {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  city        String
  state       String
  latitude    Decimal  @db.Decimal(9, 6)
  longitude   Decimal  @db.Decimal(9, 6)
  radiusMeters Int     @default(10000)
  qrCodeUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users     User[]
  merchants Merchant[]
  coupons   Coupon[]

  @@index([slug])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  iconUrl   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coupons   Coupon[]

  @@index([slug])
}

model Merchant {
  id          String   @id @default(cuid())
  name        String
  description String?
  areaId      String
  ownerId     String?
  address     String
  latitude    Decimal  @db.Decimal(9, 6)
  longitude   Decimal  @db.Decimal(9, 6)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  area                  Area                   @relation(fields: [areaId], references: [id])
  owner                 User?                  @relation(fields: [ownerId], references: [id])
  coupons               Coupon[]
  notificationCooldowns NotificationCooldown[]

  @@index([areaId])
}

model Coupon {
  id          String       @id @default(cuid())
  title       String
  description String
  imageUrl    String?
  shareSlug   String       @unique
  status      CouponStatus @default(DRAFT)
  startsAt    DateTime?
  expiresAt   DateTime?
  areaId      String
  merchantId  String
  categoryId  String?
  isWhitelisted Boolean @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  area     Area     @relation(fields: [areaId], references: [id])
  merchant Merchant @relation(fields: [merchantId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])
  savedBy  SavedCoupon[]
  redemptions CouponRedemption[]

  @@index([areaId, status])
  @@index([categoryId])
  @@index([merchantId])
}

model CouponRedemption {
  id        String   @id @default(cuid())
  userId    String
  couponId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  coupon Coupon @relation(fields: [couponId], references: [id])

  @@index([userId])
  @@index([couponId])
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String?
  fullName  String
  email     String
  message   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model LegalDocument {
  id        String   @id @default(cuid())
  type      String   @unique
  title     String
  content   String
  version   String   @default("1.0")
  updatedAt DateTime @updatedAt
}

model SavedCoupon {
  id        String   @id @default(cuid())
  userId    String
  couponId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  coupon Coupon @relation(fields: [couponId], references: [id])

  @@unique([userId, couponId])
  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt, createdAt])
}

model NotificationCooldown {
  id         String   @id @default(cuid())
  userId     String
  merchantId String
  lastSentAt DateTime

  user     User     @relation(fields: [userId], references: [id])
  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@unique([userId, merchantId])
}
